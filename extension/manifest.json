{
  "manifest_version": 3,
  "name": "KidGuard",
  "version": "0.1.0",
  "description": "Applies child-safe browsing rules based on who is at the computer (prototype).",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": ["nativeMessaging", "webNavigation", "tabs", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "KidGuard", "default_popup": "popup.html" },
  "incognito": "spanning"
}
